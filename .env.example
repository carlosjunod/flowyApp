EXPO_PUBLIC_API_BASE_URL=http://localhost:4000
EXPO_PUBLIC_PB_URL=http://localhost:8090
EXPO_PUBLIC_R2_PUBLIC_URL=https://files.tryflowy.app

# Build-time file path for the Android Firebase config matching app.tryflowy.client.
# In EAS, create GOOGLE_SERVICES_JSON as a file environment variable.
# GOOGLE_SERVICES_JSON=/absolute/path/to/google-services.json

# Google Sign-In for iOS (public OAuth IDs, not secrets).
# iOS client must belong to app.tryflowy.client in the existing Google project.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# Must match the server GOOGLE_CLIENT_ID (OAuth client type Web application).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
